# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# N8N_WEBHOOK_URL: Production n8n chat webhook URL (POST JSON).
# Set or update this in Vercel (Project Settings -> Environment Variables) or
# AI Studio's Secrets panel anytime your n8n webhook changes—no code edits needed.
# Leave blank to use the built-in default production webhook.
N8N_WEBHOOK_URL=""

# ALLOWED_WEBHOOK_HOSTS: Optional comma-separated list of custom self-hosted n8n domains
# allowed for per-browser overrides via /api/chat (in addition to *.app.n8n.cloud).
ALLOWED_WEBHOOK_HOSTS=""


